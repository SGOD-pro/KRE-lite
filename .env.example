# ==============================================================================
# CITED-OR-SILENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# AWS Bedrock Credentials & Region
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-south-1

# AWS Bedrock Model Identifiers
BEDROCK_TITAN_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_NOVA_MODEL_ID=apac.amazon.nova-pro-v1:0

# Qdrant Vector Database (Cloud or Local)
# For Qdrant Cloud: https://xxxxxx.cloud.qdrant.io:6333
# For Local: http://localhost:6333 (or leave blank for in-memory during testing)
QDRANT_ENDPOINT=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# MongoDB Atlas (Raw Chunks & Session Store)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hackathon_db

# Fallback LLM Provider (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
