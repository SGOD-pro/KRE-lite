# .env.example — copy to .env and fill in real values.
# Do NOT commit .env to source control (it's in .gitignore).
#
# ─────────────────────────────────────────────────────────────────
# ENV controls the boto3 credential/endpoint strategy:
#
#   dev   → profile_name="aws"   | real AWS (Bedrock + RDS + ElastiCache)
#   local → profile_name="local" | LocalStack at http://localhost:4566
#             RDS + Redis still connect to localhost via psycopg2/redis-py
#   prod  → no profile           | IAM role (ECS / EC2 / Lambda)
# ─────────────────────────────────────────────────────────────────
ENV=dev

# AWS region
AWS_REGION=ap-south-1

# LocalStack endpoint (only read when ENV=local)
LOCALSTACK_ENDPOINT=http://localhost:4566

# ── Bedrock model IDs ─────────────────────────────────────────────
TITAN_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
NOVA_LLM_MODEL_ID=amazon.nova-pro-v1:0

# ── AWS S3 ────────────────────────────────────────────────────────
S3_BUCKET_NAME=cited-or-silent-docs

# ── MongoDB Atlas ─────────────────────────────────────────────────
# Create a free cluster at mongodb.com
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cited_or_silent

# ── Qdrant Cloud ──────────────────────────────────────────────────
# Create a free cluster at qdrant.cloud
QDRANT_ENDPOINT=https://<your-cluster>.qdrant.tech
QDRANT_API_KEY=<your-api-key>
